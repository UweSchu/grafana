                        "format": "table",
                        "query": "from(bucket: \"influxdb\")\r\n|\u003e range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n|\u003e filter(fn: (r) =\u003e \r\n    r[\"_measurement\"] == \"bucket\" and\r\n    r[\"_field\"] == \"size\"\r\n)\r\n|\u003e aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  DATE_BIN($__interval, time) AS time,\r\n  mean(size) AS size\r\nFROM\r\n  bucket\r\nWHERE\r\n  time \u003e= $__timeFrom\r\n  AND time \u003c= $__timeTo\r\nGROUP BY\r\n  1\r\nORDER BY\r\n  1",
